{
  "name": "@framediff/example-studio-playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A guided FrameDiff Studio acceptance playground covering authoring, editing, motion, simulation, generation, audio, and delivery.",
  "scripts": {
    "prepare": "svelte-kit sync",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:authoring": "node vendor/framediff/scripts/check-example-authoring.mjs .",
    "check:bundle": "node vendor/framediff/scripts/check-bundle-budgets.mjs .",
    "typecheck": "npm run check",
    "test": "vitest run src/data/heroEdl.test.ts src/compositions/playground/StudioPlaygroundGuide.test.ts src/compositions/labs/ProductionLabGuide.test.ts src/compositions/labs/EditableTextCoverage.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@framediff/common-api": "file:vendor/framediff/packages/common-api",
    "@framediff/studio-model": "file:vendor/framediff/packages/studio-model",
    "@framediff/studio-ui": "file:vendor/framediff/packages/studio-ui",
    "framediff": "file:vendor/framediff/packages/framediff",
    "gsap": "^3.15.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@webgpu/types": "^0.1.71",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.5",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
